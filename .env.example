# 이 파일을 복사해서 `.env`로 만든 뒤 실제 키를 채우세요.
#
#     cp .env.example .env
#
# ⚠️ `.env`는 .gitignore에 있어 git에 올라가지 않습니다. 실제 키 값은
#    절대 저장소에 커밋하지 마세요 (CLAUDE.md 6절).
# ⚠️ 이미 설정된 환경변수가 항상 이 파일보다 우선합니다 —
#    Render 대시보드에 넣은 값이나 `KEY=... python ...` 방식은 그대로 동작합니다.

# 국토교통부 공공데이터포털 인증키 (data.go.kr → 마이페이지 → 오픈API → 인증키)
# 실거래가(매매/전월세/아파트)와 건축물대장 조회에 모두 씁니다.
MOLIT_SERVICE_KEY=

# 카카오 REST API 키 (developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키)
# 주소를 좌표로 바꾸고(지오코딩) 주변 시설을 찾는 데 씁니다. 서버 전용 비밀키입니다.
KAKAO_REST_API_KEY=

# (선택) 카카오 JavaScript 키 — 결과 페이지 지도 미리보기용 (27-1절)
# ⚠️ 이 키는 브라우저에 그대로 노출되는 게 정상입니다. 대신 카카오 개발자
#    콘솔에 사용할 도메인을 등록해서 보호합니다. 없으면 지도 카드만 생략됩니다.
KAKAO_JS_KEY=

# (선택) 경기데이터드림 인증키 — 경기도 중개업소 조회용 (21절)
GG_DATA_KEY=
